APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This application uses TWO databases, and getting that wrong is the most
# damaging mistake available during setup.
#
#   mysql     the shared CLAS schema, which the Yii application also reads
#             and writes. 81 tables. This API adds columns to it and nothing
#             else.
#   clas_api  this application's own schema: the migration history, and the
#             few tables that are purely our bookkeeping (stripe_events,
#             subscription_reminders).
#
# Migrations are always run with `--database=clas_api`, which keeps the
# history in our own schema while the migrations that declare
# `protected $connection = 'mysql'` still alter the shared one. Running a
# bare `php artisan migrate` would create the history table, and Laravel's
# default users/sessions/cache/jobs tables, inside the shared CLAS database.
# deploy.sh passes the flag; do the same by hand.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clas
DB_USERNAME=
DB_PASSWORD=

# Defaults to the DB_* values above for everything but the schema name, so
# only override what actually differs.
CLAS_API_DB_DATABASE=clas_api
# CLAS_API_DB_HOST=127.0.0.1
# CLAS_API_DB_PORT=3306
# CLAS_API_DB_USERNAME=
# CLAS_API_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_TIMEZONE_KEY=

NOTIFY_MOVEMENT_BCC=
NOTIFY_FROM_ADDRESS=info@canadianlandaccess.com

# Where the Yii application still lives. Email confirmation and password reset
# are pages it serves, and the links this API mails have to point at it.
LEGACY_WEB_URL=https://canadianlandaccess.com

# Who hears about a reported issue. ADMIN_EMAIL is the recipient;
# ISSUE_NOTIFY_EMAILS is a comma-separated Bcc list and may be empty.
ADMIN_EMAIL=info@canadianlandaccess.com
ISSUE_NOTIFY_EMAILS=

# Push delivery. The old application used FCM's legacy API, which Google shut
# down in July 2024; this speaks the v1 API and needs a service account.
# Drivers: log (default, writes intended pushes to the log), fcm, null.
PUSH_DRIVER=log
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# PEASI emergency alert forwarding. Off unless a URL and token are set.
PEASI_ENABLED=false
PEASI_URL=
PEASI_TOKEN=

# Stripe. Test mode only unless STRIPE_ALLOWED_KEY_PREFIXES says otherwise,
# which is what stops a live key being used by accident.
STRIPE_KEY=
STRIPE_SECRET=
# From the Stripe dashboard, once a webhook endpoint exists for
# POST /v1/stripe/webhook. Until it is set, that endpoint refuses every
# request with 503 — the signature is its only authentication, so accepting
# unsigned payloads is not an option. Stripe retries a 5xx, so events that
# arrive before this is set are redelivered rather than lost.
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOWED_KEY_PREFIXES=sk_test_
STRIPE_CURRENCY=cad
